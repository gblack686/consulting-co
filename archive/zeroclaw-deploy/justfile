# View bootstrap log (useful right after deploy)
setup-log instance=default_instance:
    #!/usr/bin/env bash
    set -euo pipefail
    CID=$(aws ssm send-command --instance-ids {{instance}} \
      --document-name "AWS-RunShellScript" \
      --parameters '{"commands":["tail -30 /var/log/zeroclaw-setup.log 2>&1"]}' \
      --output text --query "Command.CommandId")
    sleep 8
    aws ssm get-command-invocation --command-id "$CID" \
      --instance-id {{instance}} \
      --query "StandardOutputContent" --output text

# Open SSM session (interactive shell)
ssh instance=default_instance:
    aws ssm start-session --target {{instance}}

# Restart services
restart instance=default_instance:
    #!/usr/bin/env bash
    set -euo pipefail
    CID=$(aws ssm send-command --instance-ids {{instance}} \
      --document-name "AWS-RunShellScript" \
      --parameters '{"commands":["systemctl restart zeroclaw && sleep 2 && systemctl restart gateway-proxy && echo Services restarted"]}' \
      --output text --query "Command.CommandId")
    sleep 8
    aws ssm get-command-invocation --command-id "$CID" \
      --instance-id {{instance}} \
      --query "StandardOutputContent" --output text

# Run a remote command via SSM
run instance=default_instance cmd="zeroclaw --version":
    #!/usr/bin/env bash
    set -euo pipefail
    CID=$(aws ssm send-command --instance-ids {{instance}} \
      --document-name "AWS-RunShellScript" \
      --parameters "{\"commands\":[\"sudo -u ubuntu HOME=/home/ubuntu {{cmd}} 2>&1\"]}" \
      --output text --query "Command.CommandId")
    sleep 8
    aws ssm get-command-invocation --command-id "$CID" \
      --instance-id {{instance}} \
      --query "StandardOutputContent" --output text

# --- Skill Deployment ---

# Deploy a skill to the instance via S3
deploy-skill skill instance=default_instance client=default_client:
    #!/usr/bin/env bash
    set -euo pipefail
    SKILL_DIR="{{deploy_dir}}/skills/{{skill}}"
    if [ ! -f "$SKILL_DIR/SKILL.md" ]; then
      echo "ERROR: $SKILL_DIR/SKILL.md not found"
      exit 1
    fi

    BUCKET="zeroclaw-bundle-{{client}}-$(aws sts get-caller-identity --query Account --output text)"
    echo "Uploading {{skill}} to S3..."
    aws s3 cp "$SKILL_DIR/SKILL.md" "s3://$BUCKET/skills/{{skill}}/SKILL.md"

    echo "Downloading on instance..."
    CID=$(aws ssm send-command --instance-ids {{instance}} \
      --document-name "AWS-RunShellScript" \
      --parameters "{\"commands\":[
        \"mkdir -p /home/ubuntu/.zeroclaw/workspace/skills/{{skill}}\",
        \"aws s3 cp s3://$BUCKET/skills/{{skill}}/SKILL.md /home/ubuntu/.zeroclaw/workspace/skills/{{skill}}/SKILL.md\",
        \"chown -R ubuntu:ubuntu /home/ubuntu/.zeroclaw/workspace/skills/{{skill}}\",
        \"echo Skill {{skill}} deployed\"
      ]}" --output text --query "Command.CommandId")
    sleep 8
    aws ssm get-command-invocation --command-id "$CID" \
      --instance-id {{instance}} \
      --query "StandardOutputContent" --output text

# List deployed skills
skills instance=default_instance:
    #!/usr/bin/env bash
