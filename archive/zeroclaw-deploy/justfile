    aws ssm get-command-invocation --command-id "$CID" \
      --instance-id {{instance}} \
      --query "StandardOutputContent" --output text

# --- E2E Test ---

# End-to-end WebSocket test
e2e ip=default_ip token="0cd8108d-e545-4924-9c24-80baf84a5726":
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Running E2E test against ws://{{ip}}:3050..."
    node -e "
    const WebSocket = require('ws');
    const ws = new WebSocket('ws://{{ip}}:3050?token={{token}}');
    let gotResponse = false;
    ws.on('open', () => {
      console.log('Connected. Sending test message...');
      ws.send(JSON.stringify({type:'user_message',content:'Say hello in one sentence'}));
    });
    ws.on('message', (d) => {
      const m = JSON.parse(d);
      if (m.type === 'orchestrator_chat') {
        console.log('Response:', m.data.content.slice(0, 200));
        gotResponse = true;
      }
      if (m.type === 'chat_stream' && m.is_complete) {
        console.log(gotResponse ? 'PASS' : 'FAIL: no response');
        ws.close();
      }
    });
    ws.on('error', (e) => { console.log('FAIL:', e.message); process.exit(1); });
    setTimeout(() => { console.log(gotResponse ? 'PASS (timeout)' : 'FAIL: timeout'); ws.close(); process.exit(gotResponse ? 0 : 1); }, 30000);
    "

# --- Stack Info ---

# Show CloudFormation outputs for a client stack
outputs client=default_client:
    @aws cloudformation describe-stacks \
      --stack-name "ZeroClaw-{{client}}" \
      --query "Stacks[0].Outputs[*].[OutputKey,OutputValue]" \
      --output table 2>/dev/null || echo "Stack ZeroClaw-{{client}} not found"

# List all ZeroClaw stacks
stacks:
    @aws cloudformation list-stacks \
      --stack-status-filter CREATE_COMPLETE UPDATE_COMPLETE \
      --query "StackSummaries[?starts_with(StackName,'ZeroClaw-')].[StackName,CreationTime,StackStatus]" \
      --output table
