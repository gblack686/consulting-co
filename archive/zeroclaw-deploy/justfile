# ZeroClaw Deploy — justfile
# One-command CDK deployment for consulting client ZeroClaw instances
#
# Usage:
#   just deploy client=greg-trading tier=cheap
#   just status
#   just health
#   just doctor
#   just logs
#   just ssh
#   just destroy client=greg-trading

set shell := ["bash", "-cu"]

project_root := `git rev-parse --show-toplevel`
deploy_dir := project_root + "/zeroclaw-deploy"

# Current deployed instance defaults
default_instance := "i-0487dd1848f73cb3e"
default_ip := "13.223.130.153"
default_client := "greg-trading"

# --- Deployment ---

# Deploy a ZeroClaw instance for a client
deploy client tier="cheap":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{deploy_dir}}"

    # Get OpenRouter key from AWS Secrets Manager
    ORKEY=$(aws secretsmanager get-secret-value \
      --secret-id gbautomation/core/openrouter-api-key \
      --query SecretString --output text 2>/dev/null)

    if [ -z "$ORKEY" ]; then
      echo "ERROR: Could not retrieve OpenRouter key from Secrets Manager"
      exit 1
    fi

    echo "Deploying ZeroClaw for client={{client}} tier={{tier}}"
    npm install --silent
    npx cdk deploy \
      --context client={{client}} \
      --context openrouterKey="$ORKEY" \
      --context modelTier={{tier}} \
      --require-approval never

    echo ""
    echo "=== Deploy complete. Waiting 60s for bootstrap... ==="
    sleep 60

    # Get outputs
    STACK="ZeroClaw-{{client}}"
    IP=$(aws cloudformation describe-stacks --stack-name "$STACK" \
      --query "Stacks[0].Outputs[?OutputKey=='PublicIp'].OutputValue" --output text 2>/dev/null)
    TOKEN=$(aws cloudformation describe-stacks --stack-name "$STACK" \
      --query "Stacks[0].Outputs[?OutputKey=='GatewayToken'].OutputValue" --output text 2>/dev/null)
    INSTANCE=$(aws cloudformation describe-stacks --stack-name "$STACK" \
      --query "Stacks[0].Outputs[?OutputKey=='InstanceId'].OutputValue" --output text 2>/dev/null)

    echo ""
    echo "=== ZeroClaw Deployed ==="
    echo "IP:       $IP"
    echo "Instance: $INSTANCE"
    echo "Token:    $TOKEN"
    echo "Health:   http://$IP:3050/health"
    echo "WS:       ws://$IP:3050?token=$TOKEN"
    echo "SSM:      aws ssm start-session --target $INSTANCE"

# Synthesize CloudFormation template (dry run)
synth client="greg-trading" tier="cheap":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{deploy_dir}}"
    npx cdk synth \
      --context client={{client}} \
      --context openrouterKey=PLACEHOLDER \
      --context modelTier={{tier}} 2>&1 | head -80

# Destroy a ZeroClaw stack
destroy client:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{deploy_dir}}"
    echo "WARNING: Destroying ZeroClaw-{{client}} stack"
    npx cdk destroy "ZeroClaw-{{client}}" --force

# Bootstrap CDK (first time per account/region)
bootstrap:
    cd "{{deploy_dir}}" && npx cdk bootstrap

# --- Instance Operations ---

# Check proxy health
health ip=default_ip:
    @curl -s "http://{{ip}}:3050/health" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'Status: {d[\"status\"]}  Uptime: {d[\"uptime\"]:.0f}s  Connections: {d[\"connections\"]}')" 2>/dev/null || curl -s "http://{{ip}}:3050/health"

# Run zeroclaw doctor via SSM
doctor instance=default_instance:
    #!/usr/bin/env bash
    set -euo pipefail
    CID=$(aws ssm send-command --instance-ids {{instance}} \
      --document-name "AWS-RunShellScript" \
      --parameters '{"commands":["sudo -u ubuntu HOME=/home/ubuntu zeroclaw doctor 2>&1"]}' \
      --output text --query "Command.CommandId")
    sleep 8
    aws ssm get-command-invocation --command-id "$CID" \
      --instance-id {{instance}} \
      --query "StandardOutputContent" --output text

# Full status check
status instance=default_instance ip=default_ip:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== Health Check ==="
    curl -s "http://{{ip}}:3050/health" 2>/dev/null || echo "Proxy unreachable"
    echo ""
    echo ""
    echo "=== SSM Status ==="
    CID=$(aws ssm send-command --instance-ids {{instance}} \
      --document-name "AWS-RunShellScript" \
      --parameters '{"commands":[
        "echo === Services ===",
        "systemctl status zeroclaw --no-pager 2>&1 | head -5",
        "systemctl status gateway-proxy --no-pager 2>&1 | head -5",
        "echo === Doctor ===",
        "sudo -u ubuntu HOME=/home/ubuntu zeroclaw doctor 2>&1 | tail -3",
        "echo === Skills ===",
        "sudo -u ubuntu HOME=/home/ubuntu zeroclaw skills list 2>&1",
        "echo === Memory ===",
        "free -h | head -2",
        "echo === Disk ===",
        "df -h / | tail -1"
      ]}' --output text --query "Command.CommandId")
    sleep 10
    aws ssm get-command-invocation --command-id "$CID" \
      --instance-id {{instance}} \
      --query "StandardOutputContent" --output text

# View ZeroClaw logs
