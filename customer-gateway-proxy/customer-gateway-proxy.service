[Unit]
Description=Customer Gateway Proxy - OpenClaw Bridge
After=network.target openclaw-gateway.service
Wants=openclaw-gateway.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/customer-gateway-proxy
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3050
Environment=OPENCLAW_WS_URL=ws://127.0.0.1:18789
Environment=OPENCLAW_AUTH_TOKEN=f25cd1c6a865d62023226f4bb663bfcff0dd5ab28c155d82
StandardOutput=journal
StandardError=journal
SyslogIdentifier=customer-gateway-proxy

[Install]
WantedBy=multi-user.target
