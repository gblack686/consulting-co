-lib.aws_iam.CfnPolicy","version":"2.241.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::IAM::Policy","aws:cdk:cloudformation:props":{"policyDocument":{"Statement":[{"Action":["s3:GetObject*","s3:GetBucket*","s3:List*"],"Effect":"Allow","Resource":[{"Fn::GetAtt":["BundleBucket1F629586","Arn"]},{"Fn::Join":["",[{"Fn::GetAtt":["BundleBucket1F629586","Arn"]},"/*"]]}]}],"Version":"2012-10-17"},"policyName":"ZeroClawRoleDefaultPolicyAAD8F209","roles":[{"Ref":"ZeroClawRole06D4FAC4"}]}}}}}}},"ZeroClawInstance":{"id":"ZeroClawInstance","path":"ZeroClaw-greg-trading/ZeroClawInstance","constructInfo":{"fqn":"aws-cdk-lib.aws_ec2.Instance","version":"2.241.0"},"children":{"InstanceProfile":{"id":"InstanceProfile","path":"ZeroClaw-greg-trading/ZeroClawInstance/InstanceProfile","constructInfo":{"fqn":"aws-cdk-lib.aws_iam.CfnInstanceProfile","version":"2.241.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::IAM::InstanceProfile","aws:cdk:cloudformation:props":{"roles":[{"Ref":"ZeroClawRole06D4FAC4"}]}}},"Resource":{"id":"Resource","path":"ZeroClaw-greg-trading/ZeroClawInstance/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_ec2.CfnInstance","version":"2.241.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::EC2::Instance","aws:cdk:cloudformation:props":{"availabilityZone":"us-east-1a","blockDeviceMappings":[{"deviceName":"/dev/sda1","ebs":{"volumeSize":20,"volumeType":"gp3"}}],"iamInstanceProfile":{"Ref":"ZeroClawInstanceInstanceProfile8028132D"},"imageId":"ami-0071174ad8cbb9e17","instanceType":"t3.medium","securityGroupIds":[{"Fn::GetAtt":["ZeroClawSGB6B2857F","GroupId"]}],"subnetId":"subnet-0651992e07deb99f6","tags":[{"key":"Client","value":"greg-trading"},{"key":"Name","value":"zeroclaw-greg-trading"},{"key":"Project","value":"zeroclaw"}],"userData":{"Fn::Base64":{"Fn::Join":["",["#!/bin/bash\n#!/bin/bash\nset -euo pipefail\nexec > /var/log/zeroclaw-setup.log 2>&1\necho \"=== ZeroClaw bootstrap starting ===\"\n\n# 1. System deps + AWS CLI v2\napt-get update -qq\napt-get install -y -qq unzip curl\ncurl -fsSL \"https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip\" -o /tmp/awscliv2.zip\nunzip -q /tmp/awscliv2.zip -d /tmp\n/tmp/aws/install\nrm -rf /tmp/awscliv2.zip /tmp/aws\n\n# 2. Download ZeroClaw binary\nZEROCLAW_VERSION=\"v0.1.7\"\ncd /tmp\ncurl -fsSL \"https://github.com/zeroclaw-labs/zeroclaw/releases/download/${ZEROCLAW_VERSION}/zeroclaw-x86_64-unknown-linux-gnu.tar.gz\" -o zeroclaw.tar.gz\ntar xzf zeroclaw.tar.gz\nmv zeroclaw /usr/local/bin/zeroclaw\nchmod +x /usr/local/bin/zeroclaw\nrm zeroclaw.tar.gz\necho \"=== ZeroClaw binary installed ===\"\n\n# 3. Download bundle from S3\nBUCKET=\"",{"Ref":"BundleBucket1F629586"},"\"\nmkdir -p /home/ubuntu/.zeroclaw /opt/gateway-proxy\naws s3 cp s3://$BUCKET/bundle/config.toml /home/ubuntu/.zeroclaw/config.toml\naws s3 cp --recursive s3://$BUCKET/bundle/workspace/ /home/ubuntu/.zeroclaw/workspace/\naws s3 cp --recursive s3://$BUCKET/bundle/proxy/ /opt/gateway-proxy/\nchown -R ubuntu:ubuntu /home/ubuntu/.zeroclaw\necho \"=== Bundle downloaded from S3 ===\"\n\n# 4. ZeroClaw systemd service\ncat > /etc/systemd/system/zeroclaw.service << SVCEOF\n[Unit]\nDescription=ZeroClaw Gateway\nAfter=network.target\n\n[Service]\nType=simple\nUser=ubuntu\nExecStart=/usr/local/bin/zeroclaw daemon\nRestart=always\nRestartSec=3\nEnvironment=HOME=/home/ubuntu\nEnvironment=OPENROUTER_API_KEY=PLACEHOLDER\nEnvironment=ZEROCLAW_API_KEY=PLACEHOLDER\n\n[Install]\nWantedBy=multi-user.target\nSVCEOF\n\n# 5. Install Node.js 22\ncurl -fsSL https://deb.nodesource.com/setup_22.x | bash -\napt-get install -y nodejs\necho \"=== Node.js installed: $(node --version) ===\"\n\n# 6. Install agent-browser globally\nnpm install -g agent-browser\necho \"=== agent-browser installed: $(agent-browser --version 2>/dev/null || echo unknown) ===\"\n\n# 7. Install Chromium deps for agent-browser headless (Ubuntu 24.04)\napt-get install -y -qq libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 \\\n  libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxrandr2 libgbm1 \\\n  libpango-1.0-0 libasound2t64 libxshmfence1 fonts-liberation xdg-utils || \\\n  apt-get install -y -qq libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \\\n    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxrandr2 libgbm1 \\\n    libpango-1.0-0 libasound2 libxshmfence1 fonts-liberation xdg-utils\n# Let agent-browser download its own Chromium on first run\nsu - ubuntu -c \"agent-browser --version\" || true\necho \"=== Chromium deps installed ===\"\n\n# 8. Install proxy dependencies\ncd /opt/gateway-proxy && npm install --production\nchown -R ubuntu:ubuntu /opt/gateway-proxy\n\n# 9. Gateway proxy systemd service\ncat > /etc/systemd/system/gateway-proxy.service << PROXYEOF\n[Unit]\nDescription=Customer Gateway Proxy\nAfter=zeroclaw.service\n\n[Service]\nType=simple\nUser=ubuntu\nWorkingDirectory=/opt/gateway-proxy\nExecStart=/usr/bin/node server.js\nRestart=always\nRestartSec=3\nEnvironment=ZEROCLAW_WS_URL=ws://127.0.0.1:18789/ws/chat\nEnvironment=ZEROCLAW_AUTH_TOKEN=baa079ac-8cec-4eb3-83df-c822c778ed37\nEnvironment=PORT=3050\n\n[Install]\nWantedBy=multi-user.target\nPROXYEOF\n\n# 10. Enable and start services\nsystemctl daemon-reload\nsystemctl enable zeroclaw gateway-proxy\nsystemctl start zeroclaw\nsleep 2\nsystemctl start gateway-proxy\n\necho \"=== ZeroClaw bootstrap complete ===\""]]}}}}}}},"ZeroClawEIP":{"id":"ZeroClawEIP","path":"ZeroClaw-greg-trading/ZeroClawEIP","constructInfo":{"fqn":"aws-cdk-lib.aws_ec2.CfnEIP","version":"2.241.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::EC2::EIP","aws:cdk:cloudformation:props":{"tags":[{"key":"Name","value":"zeroclaw-greg-trading-eip"}]}}},"ZeroClawEIPAssoc":{"id":"ZeroClawEIPAssoc","path":"ZeroClaw-greg-trading/ZeroClawEIPAssoc","constructInfo":{"fqn":"aws-cdk-lib.aws_ec2.CfnEIPAssociation","version":"2.241.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::EC2::EIPAssociation","aws:cdk:cloudformation:props":{"allocationId":{"Fn::GetAtt":["ZeroClawEIP"