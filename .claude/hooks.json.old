{
  "hooks": [
    {
      "name": "log_to_graphiti",
      "description": "Log Claude Code conversations to Graphiti knowledge graph using Claude subagent for entity extraction",
      "event": "Stop",
      "command": "python",
      "args": [".claude/hooks/log_to_graphiti.py"]
    },
    {
      "name": "log_to_langfuse",
      "description": "Log Claude Code conversations to Langfuse for observability tracking",
      "event": "Stop",
      "command": "python",
      "args": [".claude/hooks/log_to_langfuse.py"]
    }
  ]
}
