#!/usr/bin/env python3
"""
PostToolUse Hook - Records when a tool execution ends.
This hook fires AFTER tool execution to capture the end time and calculate latency.
"""

import os
import sys
import json
from pathlib import Path
from datetime import datetime
from dotenv import load_dotenv

# Add utils to path
sys.path.insert(0, str(Path(__file__).parent / "utils"))

# Load environment
load_dotenv(Path(__file__).parent.parent / '.env')

from tool_timing import record_tool_end

def main():
    """Main hook entry point."""

    # Read hook data from stdin
    try:
        hook_data = json.load(sys.stdin)
    except:
        return

    session_id = hook_data.get("session_id", "unknown")
    tool_name = hook_data.get("tool_name", "unknown")
    tool_output = hook_data.get("tool_output", {})

    # Record the end time and calculate latency
    try:
        timing_data = record_tool_end(session_id, tool_name, tool_output)

        # Debug logging if enabled
        if os.getenv("DEBUG_TOOL_TIMING", "false").lower() == "true":
            debug_log = Path(__file__).parent.parent / ".claude" / "tool_timing_debug.log"
            with open(debug_log, "a", encoding="utf-8") as f:
                f.write(f"\n✓ {tool_name}: {timing_data.get('latency_ms', 0)}ms\n")
    except Exception as e:
        # Silently fail - don't break Claude Code execution
        pass

if __name__ == "__main__":
    main()
