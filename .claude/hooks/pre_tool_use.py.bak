#!/usr/bin/env python3
"""
PreToolUse Hook - Records when a tool execution starts.
This hook fires BEFORE tool execution to capture the start time.
"""

import os
import sys
import json
from pathlib import Path
from datetime import datetime
from dotenv import load_dotenv

# Add utils to path
sys.path.insert(0, str(Path(__file__).parent / "utils"))

# Load environment
load_dotenv(Path(__file__).parent.parent / '.env')

from tool_timing import record_tool_start

def main():
    """Main hook entry point."""

    # Read hook data from stdin
    try:
        hook_data = json.load(sys.stdin)
    except:
        return

    session_id = hook_data.get("session_id", "unknown")
    tool_name = hook_data.get("tool_name", "unknown")
    tool_input = hook_data.get("tool_input", {})

    # Record the start time
    try:
        record_tool_start(session_id, tool_name, tool_input)
    except Exception as e:
        # Silently fail - don't break Claude Code execution
        pass

if __name__ == "__main__":
    main()
