{
  "permissions": {
    "allow": [
      "Bash(gws *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(gws gmail +send *)",
      "Bash(gws drive +upload *)"
    ]
  }
}
